# Copy to .env and adjust. All settings are optional.
# On Railway, set these in the web service's Variables tab instead.

# PostgreSQL connection. On Railway: ${{Postgres.DATABASE_URL}}
# Leave empty to use the built-in database stored in data/pglite.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Name shown in the app, the browser tab and on phone home screens.
APP_NAME=Reel Board

# Recommended on a public server: until the admin account exists, the setup page then only
# works via https://your-site/setup?token=<this value>. Use any long random string.
# SETUP_TOKEN=change-me-to-something-long-and-random

# Docker compose only: password for its PostgreSQL, public domain for automatic HTTPS, host port.
# POSTGRES_PASSWORD=change-me
# DOMAIN=reels.example.com
# PORT=3000

# Local runs only: where the built-in database is kept (default ./data).
# DATA_DIR=./data
